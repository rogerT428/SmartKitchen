<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@id/btn_welcome_start"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <!-- Logo -->
        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_smart_kitchen_logo" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="@string/welcome_title"
            android:textColor="@color/brand_maroon"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/welcome_desc"
            android:textColor="@color/brand_maroon_dark"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Mulai Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_welcome_start"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/brand_maroon"
        android:fontFamily="sans-serif-medium"
        android:text="@string/btn_start"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="26dp"
        app:layout_constraintBottom_toTopOf="@id/btn_welcome_about" />

    <!-- Tentang Aplikasi Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_welcome_about"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="40dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/btn_about"
        android:textColor="@color/brand_maroon"
        android:textSize="15sp"
        app:cornerRadius="26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeColor="@color/brand_maroon"
        app:strokeWidth="1.5dp" />

</androidx.constraintlayout.widget.ConstraintLayout>